# Ensure devcontainer scripts keep Unix LF line endings.
# Prevents misleading "/bin/sh: ...: not found" errors from CRLF shebangs.
.devcontainer/*.sh text eol=lf
.devcontainer/*.json text eol=lf
.gitattributes text eol=lf

# Memory manifests hash canonical and generated bytes across Windows checkouts.
packages/memory/** text=auto eol=lf
packages/software-team/github-copilot/memory/** text=auto eol=lf
packages/software-team/github-copilot/skills/memory*/** text=auto eol=lf
packages/software-team/github-copilot/.memory-package.json text eol=lf
